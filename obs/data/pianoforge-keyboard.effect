// The PianoForge keyboard's drawing (obs/src/keyboard_source.cpp): rounded boxes with a gradient, a rim and a light
// from within (keys, notes, pedals, shadows), lights added over them (halos, beams, ripples, sparkles, the melody's
// line, the ambiance), and the bloom over the whole.
//
// Each shape but the sparkles is drawn on a quad, quad_origin and quad_size in the source's pixels, its texture coordinates running
// from 0 to 1 across it: the shader works in the source's pixels, so a quad cut at the source's edge cuts the shape
// and does not squeeze it. Boxes give straight alpha (blended over); lights give premultiplied colour (added).

uniform float4x4 ViewProj;
uniform float2 quad_origin;    // the quad, pixels
uniform float2 quad_size;
uniform float2 box_center;     // the shape: its centre and half size, pixels
uniform float2 box_half;
uniform float box_radius;      // a box's corners
uniform float box_border;      // its rim's width (0: none)
uniform float box_soft;        // how soft its edge is, pixels (1: sharp; a shadow: several)
uniform float box_taper;       // its width at its bottom, a share of its top's (1: straight; a tail's end: narrower)
uniform float4 fill_top;       // its gradient, top to bottom (straight alpha)
uniform float4 fill_bottom;
uniform float fill_curve;      // the gradient's curve (1: even; below: it reaches the bottom's colour sooner)
uniform float4 border_color;   // the rim (alpha: how much of it)
uniform float4 light_color;    // a light: within a box, or the colour of a light added
uniform float light_strength;
uniform float light_from;      // within a box: 0 from its top, 1 from its bottom
uniform float light_reach;     // a halo's reach beyond its box, pixels
uniform float2 fade_band;      // from y = fade_band.x (nothing) to fade_band.y (whole): the shape fades upward
uniform float time;            // seconds (shimmer, twinkle)
uniform float seed;            // a shape's own phase
uniform float4 line_points[64]; // a line's points (x, y: pixels; z: brightness), line_count of them
uniform float line_count;
uniform float4 aurora_left;    // the ambiance's colours, left and right
uniform float4 aurora_right;
uniform texture2d image;       // a texture drawn (the keyboard's image, its glow)
uniform float2 texel;          // a step across it (the blur: its direction too)
uniform float bloom_gain;

sampler_state linearClamp {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float2 pixel_of(VertData v_in)
{
	return quad_origin + v_in.uv * quad_size;
}

float fade_of(float y)
{
	return saturate((y - fade_band.x) / max(fade_band.y - fade_band.x, 0.001));
}

// Signed distance to a box of half size b with corners of radius r (negative inside).
float rounded_box(float2 p, float2 b, float r)
{
	float2 q = abs(p) - b + float2(r, r);
	return length(max(q, float2(0.0, 0.0))) + min(max(q.x, q.y), 0.0) - r;
}

// A rounded box: its gradient, its rim, a light from its top or its bottom; its edge smoothed (soft: a shadow); its
// sides drawing in toward its bottom (box_taper).
float4 PSBox(VertData v_in) : TARGET
{
	float2 pix = pixel_of(v_in);
	float2 p = pix - box_center;
	float t = saturate(p.y / max(2.0 * box_half.y, 1.0) + 0.5);
	float2 size_here = float2(box_half.x * lerp(1.0, box_taper, t), box_half.y);
	float d = rounded_box(p, size_here, min(box_radius, size_here.x));
	float cover = saturate(0.5 - d / max(box_soft, 1.0));
	cover = cover * cover * (3.0 - 2.0 * cover);
	float4 c = lerp(fill_top, fill_bottom, pow(t, max(fill_curve, 0.05)));
	float rim = saturate(1.0 - abs(d + box_border * 0.5) / max(box_border * 0.5, 0.5)) * step(0.01, box_border);
	c.rgb = lerp(c.rgb, border_color.rgb, rim * border_color.a);
	float from = lerp((1.0 - t) * (1.0 - t), t * t, light_from);
	c.rgb = c.rgb + light_color.rgb * light_strength * from;
	return float4(saturate(c.rgb), c.a * cover * fade_of(pix.y));
}

// A halo around a rounded box (premultiplied, added): full within it, falling off over light_reach beyond it.
float4 PSGlow(VertData v_in) : TARGET
{
	float2 pix = pixel_of(v_in);
	float d = max(rounded_box(pix - box_center, box_half, box_radius), 0.0);
	float r = d / max(light_reach, 1.0);
	float k = light_strength * exp(-r * 1.6) * saturate(1.0 - r / 3.0) * fade_of(pix.y);
	return float4(light_color.rgb * k, saturate(k));
}

// A beam rising from a key: brightest at its foot, soft at its sides, a white core, shimmering.
float4 PSBeam(VertData v_in) : TARGET
{
	float2 pix = pixel_of(v_in);
	float x = (pix.x - box_center.x) / max(box_half.x, 1.0);
	float y = saturate((pix.y - box_center.y) / max(2.0 * box_half.y, 1.0) + 0.5); // 0 at its top, 1 at its foot
	float side = exp(-x * x * 4.0);
	float core = exp(-x * x * 50.0);
	float rise = pow(y, 2.2);
	float shimmer = 0.82 + 0.18 * sin(time * 5.0 + seed * 6.2832 + y * 9.0) * sin(time * 2.3 + seed * 3.1 - y * 4.0);
	float k = light_strength * (side * 0.65 + core * 0.55) * rise * shimmer * saturate(1.0 - abs(x));
	float3 c = lerp(light_color.rgb, float3(1.0, 1.0, 1.0), saturate(core * rise * 0.6));
	return float4(c * k, saturate(k * 0.85));
}

// A ripple: a ring of light around an ellipse (box_half its radii), light_reach its thickness in pixels.
float4 PSRing(VertData v_in) : TARGET
{
	float2 pix = pixel_of(v_in);
	float2 q = (pix - box_center) / max(box_half, float2(1.0, 1.0));
	float d = abs(length(q) - 1.0) * box_half.x;
	float k = light_strength * exp(-d * d / max(light_reach * light_reach, 0.25));
	return float4(light_color.rgb * k, saturate(k));
}

// A line of light through its points (the melody): a thin bright core in a soft halo (light_reach), as bright as
// its points at each place.
float4 PSLine(VertData v_in) : TARGET
{
	float2 pix = pixel_of(v_in);
	float best = 100000.0;
	float bright = 0.0;
	for (int i = 0; i < 63; i++) {
		if (float(i) < line_count - 1.0) {
			float2 a = line_points[i].xy;
			float2 ab = line_points[i + 1].xy - a;
			float2 ap = pix - a;
			float h = saturate(dot(ap, ab) / max(dot(ab, ab), 0.0001));
			float d = length(ap - ab * h);
			if (d < best) {
				best = d;
				bright = lerp(line_points[i].z, line_points[i + 1].z, h);
			}
		}
	}
	float core = exp(-best * best / 1.4);
	float halo = 0.45 * exp(-best / max(light_reach, 1.0));
	float k = light_strength * bright * (core + halo) * fade_of(pix.y);
	float3 c = lerp(light_color.rgb, float3(1.0, 1.0, 1.0), saturate(core * 0.6));
	return float4(c * k, saturate(k));
}

// The ambiance: curtains of light rising from the keys over the room (box_center, box_half), swaying, as strong as
// the playing is loud (light_strength), from one colour on the left to the other on the right.
float4 PSAurora(VertData v_in) : TARGET
{
	float2 pix = pixel_of(v_in);
	float2 size = max(2.0 * box_half, float2(1.0, 1.0));
	float2 q = (pix - (box_center - box_half)) / size;
	float curtain = 0.5 + 0.5 * sin(q.x * 8.0 + time * 0.55 + 2.2 * sin(q.x * 2.7 - time * 0.31));
	float folds = 0.72 + 0.28 * sin(q.x * 47.0 + 3.5 * sin(q.x * 6.1 + time * 0.7));
	float reach = 0.3 + 0.6 * curtain;
	float v = saturate(1.0 - (1.0 - q.y) / reach);
	float k = light_strength * (0.35 + 0.65 * curtain) * folds * v * v;
	float3 c = lerp(aurora_left.rgb, aurora_right.rgb, smoothstep(0.2, 0.8, q.x));
	return float4(c * k, saturate(k * 0.7));
}

// The bloom. The keyboard is drawn into an image first (premultiplied colour); its bright, coloured parts (lights,
// keys and notes lit: not the white keys) taken at a quarter of its size, blurred, and added over it.
float4 PSImage(VertData v_in) : TARGET
{
	return image.Sample(linearClamp, v_in.uv);
}

float4 PSBright(VertData v_in) : TARGET
{
	float4 c = 0.25 * (image.Sample(linearClamp, v_in.uv + texel * float2(-1.0, -1.0))
	                 + image.Sample(linearClamp, v_in.uv + texel * float2(1.0, -1.0))
	                 + image.Sample(linearClamp, v_in.uv + texel * float2(-1.0, 1.0))
	                 + image.Sample(linearClamp, v_in.uv + texel * float2(1.0, 1.0)));
	float hi = max(c.r, max(c.g, c.b));
	float lo = min(c.r, min(c.g, c.b));
	float k = smoothstep(0.1, 0.4, hi - lo) * smoothstep(0.2, 0.65, hi);
	return float4(c.rgb * k, 1.0);
}

float4 PSBlur(VertData v_in) : TARGET
{
	float4 c = image.Sample(linearClamp, v_in.uv) * 0.2270270270;
	c += (image.Sample(linearClamp, v_in.uv + texel * 1.3846153846) + image.Sample(linearClamp, v_in.uv - texel * 1.3846153846)) * 0.3162162162;
	c += (image.Sample(linearClamp, v_in.uv + texel * 3.2307692308) + image.Sample(linearClamp, v_in.uv - texel * 3.2307692308)) * 0.0702702703;
	return c;
}

float4 PSBloom(VertData v_in) : TARGET
{
	float3 c = image.Sample(linearClamp, v_in.uv).rgb * bloom_gain;
	return float4(c, saturate(max(c.r, max(c.g, c.b))));
}

// Sparkles, many in one draw: each on its own square (two triangles), its colour, brightness and phase in its
// vertices, its texture coordinates running from -1 to 1 across it (a square cut at the source's edge, less far).
struct SparkData {
	float4 pos   : POSITION;
	float4 color : COLOR;
	float2 uv    : TEXCOORD0;
	float4 spark : TEXCOORD1; // x: brightness, y: phase
};

SparkData VSSpark(SparkData v_in)
{
	SparkData v_out;
	v_out.pos   = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	v_out.color = v_in.color;
	v_out.uv    = v_in.uv;
	v_out.spark = v_in.spark;
	return v_out;
}

// A sparkle: a bright point in a soft halo, and a four-pointed star twinkling around it.
float4 PSSpark(SparkData v_in) : TARGET
{
	float2 p = v_in.uv;
	float r2 = dot(p, p);
	float core = exp(-r2 * 40.0);
	float halo = exp(-r2 * 7.0) * 0.3;
	float twinkle = 0.55 + 0.45 * sin(time * 13.0 + v_in.spark.y * 6.2832);
	float star = exp(-abs(p.x) * 22.0) * exp(-p.y * p.y * 3.0) + exp(-abs(p.y) * 22.0) * exp(-p.x * p.x * 3.0);
	float k = v_in.spark.x * (core + halo + 0.7 * star * twinkle) * saturate(1.0 - r2);
	float3 c = lerp(v_in.color.rgb, float3(1.0, 1.0, 1.0), saturate(core * 0.9));
	return float4(c * k, saturate(k));
}

technique Box
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSBox(v_in);
	}
}

technique Glow
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSGlow(v_in);
	}
}

technique Beam
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSBeam(v_in);
	}
}

technique Ring
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSRing(v_in);
	}
}

technique Sparkles
{
	pass
	{
		vertex_shader = VSSpark(v_in);
		pixel_shader  = PSSpark(v_in);
	}
}

technique Line
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSLine(v_in);
	}
}

technique Aurora
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSAurora(v_in);
	}
}

technique Image
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSImage(v_in);
	}
}

technique Bright
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSBright(v_in);
	}
}

technique Blur
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSBlur(v_in);
	}
}

technique Bloom
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSBloom(v_in);
	}
}
